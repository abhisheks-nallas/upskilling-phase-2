# Which model backend to use: groq (default) or bedrock
LLM_PROVIDER=groq

# Password for /chat/stream. Send it as the X-API-Key header
API_KEY=change-me-to-a-long-random-string

# Groq (free tier)
GROQ_API_KEY=your_key_here
GROQ_FREE_MODEL=openai/gpt-oss-20b

# AWS Bedrock (only needed when LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-5-5

# LangSmith tracing (optional). Leave LANGSMITH_PROJECT out if you use the agent id/environment pair, they conflict.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_AGENT_ID=your-agent-name
LANGSMITH_AGENT_ENVIRONMENT=local
